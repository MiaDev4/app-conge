<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Demande de congé</title>

  <!-- Bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
</head>

<body class="bg-light">

<%
  const d = demande || {};

  const formatDate = (date) => {
    if (!date) return '';
    if (typeof date === 'string') return date;
    return date.toISOString().split('T')[0];
  };
%>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">

      <div class="card shadow">
        <div class="card-header text-center fw-bold">
          📝 <%= d.id ? 'Modifier une demande' : 'Nouvelle demande de congé' %>
        </div>

        <div class="card-body">
          <form action="<%= d.id ? '/conges/' + d.id : '/conges' %>" method="POST">

            <div class="mb-3">
              <label class="form-label">Code employé</label>
              <input
                type="text"
                name="employee_code"
                class="form-control"
                value="<%= d.employee_code || '' %>"
                required
              />
            </div>

            <div class="mb-3">
              <label class="form-label">Nom employé</label>
              <input
                type="text"
                name="employee_name"
                class="form-control"
                value="<%= d.employee_name || '' %>"
                required
              />
            </div>

            <div class="mb-3">
              <label class="form-label">Date de début</label>
              <input
                type="date"
                name="start_date"
                class="form-control"
                value="<%= formatDate(d.start_date) %>"
                required
              />
            </div>

            <div class="mb-3">
              <label class="form-label">Date de fin</label>
              <input
                type="date"
                name="end_date"
                class="form-control"
                value="<%= formatDate(d.end_date) %>"
                required
              />
            </div>

            <div class="mb-3">
              <label class="form-label">Motif</label>
              <input
                type="text"
                name="motif"
                class="form-control"
                value="<%= d.motif || '' %>"
                required
              />
            </div>

            <% if (errors && errors.length > 0) { %>
              <div class="alert alert-danger">
                <%= errors[0] %>
              </div>
            <% } %>

            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-primary">
                <%= d.id ? 'Mettre à jour' : 'Soumettre la demande' %>
              </button>

              <a href="/conges" class="btn btn-outline-secondary">
                ⬅ Retour à la liste
              </a>
            </div>

          </form>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
